{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run fabrica build:*)",
      "Bash(uv run fabrica validate:*)",
      "Bash(uv run fabrica stats:*)",
      "Bash(uv run python scripts/verificar_capas.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__fna-conocimiento__buscar_fragmentos",
      "mcp__fna-conocimiento__obtener_fragmento",
      "mcp__fna-conocimiento__estadisticas_base",
      "mcp__fna-conocimiento__validar_corpus",
      "Bash(uv run fabrica graficas:*)",
      "Bash(uv run fabrica simulador:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "mcp__fna-conocimiento__consultar_pieza"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(uv run fabrica scrape:*)",
      "Bash(git commit:*)",
      "Bash(uv run fabrica pipeline:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "fna-conocimiento"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format --quiet src tests frontend scripts"
          }
        ]
      }
    ]
  }
}
