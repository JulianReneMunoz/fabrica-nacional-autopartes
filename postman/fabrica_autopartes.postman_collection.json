              "raw": "{{base_url}}/salud",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "salud"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('estado ok', () => pm.expect(pm.response.json().estado).to.eql('ok'));"
                ]
              }
            }
          ]
