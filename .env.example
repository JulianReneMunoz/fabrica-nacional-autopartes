# Copiar este archivo como .env (PowerShell: Copy-Item .env.example .env) y ajustar valores.
# El archivo .env está excluido de Git: allí se guardan los secretos locales.

# --- Proveedor LLM: ollama | openai | anthropic | claude_code | extractivo
# claude_code: Claude con la sesión de Claude Code (suscripción), sin clave de API; modelo: sonnet, opus o haiku
# FNA_PROVEEDOR_LLM=claude_code
# FNA_MODELO_LLM=sonnet
FNA_PROVEEDOR_LLM=ollama
FNA_MODELO_LLM=llama3.2:3b
FNA_OLLAMA_URL=http://localhost:11434
FNA_OLLAMA_NUM_CTX=16384
FNA_TEMPERATURA=0.1
FNA_VERSION_PROMPT=v3
# auto | completo | seleccion
FNA_MODO_CONTEXTO=auto
FNA_PRESUPUESTO_TOKENS_CONTEXTO=9000

# --- Claves de API (solo si se usan proveedores privados; dejar vacías en caso contrario)
# FNA_OPENAI_API_KEY=
# FNA_ANTHROPIC_API_KEY=

# --- Scraping responsable
FNA_PAUSA_ENTRE_PETICIONES_S=2.0
FNA_MAX_PAGINAS=80

# --- API: clave para operaciones administrativas (POST /api/v1/pipeline/reconstruir)
# Generar una clave aleatoria: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# FNA_API_CLAVE_ADMIN=

# --- MCP: permitir que la herramienta responder_pregunta invoque el LLM
FNA_MCP_PERMITIR_LLM=false

# --- Base de datos: SQLite por defecto (desarrollo); PostgreSQL para el despliegue (docker compose)
# FNA_URL_BASE_DATOS=sqlite:///data/app.db
# FNA_URL_BASE_DATOS=postgresql+psycopg://fna:fna_local@localhost:5432/fna
# Credenciales del servicio postgres de docker-compose.yml (cambiar la clave fuera del entorno local)
# FNA_PG_USUARIO=fna
# FNA_PG_CLAVE=fna_local
# FNA_PG_BASE=fna

# --- Visor 3D (Streamlit enlaza e incrusta esta URL)
# FNA_URL_VISOR=http://127.0.0.1:8000/app/

HF_TOKEN=
